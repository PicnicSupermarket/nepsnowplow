{
    "name": "neppersnowplow",
    "version": "1.0.0",
    "description": "A local Snowplow Collector and GUI to inspect collected events",
    "author": "Picnic Technologies",
    "keywords": [
        "snowplow",
        "picnic",
        "event",
        "logger",
        "inspector"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/PicnicSupermarket/nepsnowplow"
    },
    "bugs": {
        "url": "https://github.com/PicnicSupermarket/nepsnowplow/issues"
    },
    "licence": "MIT",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build && electron-builder",
        "start": "electron-vite preview",
        "typecheck": "tsc --build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "postinstall": "yarn unzip",
        "format": "yarn prettier --write .",
        "format:ci": "yarn prettier --check .",
        "unzip": "(cd jre ; unzip -o -qq \\*.zip)",
        "test": "yarn playwright test",
        "test:ci": "xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" -- yarn test"
    },
    "main": "out/main/index.mjs",
    "build": {
        "appId": "com.picnic.neppersnowplow",
        "productName": "NepperSnowplow",
        "copyright": "Copyright © 2017-2026 Picnic Technologies BV",
        "directories": {
            "output": "dist"
        },
        "dmg": {
            "writeUpdateInfo": false
        },
        "files": [
            "out/**/*"
        ],
        "extraResources": [
            "settings.json",
            "jars/**/*",
            "snowplow_micro_config/**/*"
        ],
        "artifactName": "${name}-${version}-${os}.${ext}",
        "win": {
            "extraResources": [
                {
                    "from": "jre/win32_${arch}",
                    "to": "jre/win32_${arch}"
                }
            ],
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "mac": {
            "category": "public.app-category.developer-tools",
            "extraResources": [
                {
                    "from": "jre/darwin_${arch}",
                    "to": "jre/darwin_${arch}"
                }
            ],
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64"
                    ]
                }
            ]
        }
    },
    "publish": {
        "provider": "github",
        "vPrefixedTagName": true,
        "releaseType": "draft"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.50.0",
        "@preact/preset-vite": "^2.10.5",
        "@tailwindcss/vite": "^4.3.0",
        "@types/body-parser": "^1.19.6",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.0",
        "electron": "^41.6.1",
        "electron-builder": "^26.0.0",
        "electron-vite": "^5.0.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "playwright": "^1.50.0",
        "prettier": "^2.1.1",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4",
        "vite": "^8.0.13"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@tanstack/react-virtual": "^3.13.24",
        "body-parser": "^2.2.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.3",
        "express": "^5.2.1",
        "preact": "^10.29.2",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.13"
    }
}
